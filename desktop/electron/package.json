{
  "name": "ai8video-electron",
  "version": "0.3.0",
  "description": "AI8video Electron 客户端",
  "author": "17AI8",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "dist:mac": "node ../runtime/verify_release_runtime.mjs && electron-builder --mac dmg --publish never && node ../runtime/verify_packaged_runtime.mjs dist",
    "dist:win": "node ../runtime/verify_release_runtime.mjs && electron-builder --win nsis --publish never && node ../runtime/verify_packaged_runtime.mjs dist"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.ai8.video.electron",
    "productName": "AI8video",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "icons/**/*",
      "static/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "**/*",
          "!node_modules{,/**/*}"
        ]
      },
      {
        "from": "runtime/node_modules",
        "to": "runtime/node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "icons/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
